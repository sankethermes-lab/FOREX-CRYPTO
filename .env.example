# Copy to .env and fill in (see README "Telegram setup"). Never commit .env.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
# Optional: market research briefs (research.bat) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: sure-bet alerts (python -m tracker arb) — key from https://betsapi.com
BETSAPI_TOKEN=
# Optional: a separate Telegram bot for sure-bet alerts (so /balance isn't read by the forex alerts)
ARB_TELEGRAM_BOT_TOKEN=
